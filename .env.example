# Server-only Supabase credentials. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Use independent, high-entropy values for all codes and the session signing secret.
PARTNER_SESSION_SECRET=replace-with-at-least-32-random-characters
PARTNER_STUDENT_CODE=replace-with-student-code
PARTNER_DIRECTOR_CODE=replace-with-director-code
PARTNER_LECTURERS=[{"name":"Instructor Name","code":"replace-with-instructor-code","email":"instructor@example.com","active":true}]
PARTNER_NOTIFICATION_EMAIL=project-notifications@example.com

# Email is sent only if SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=project@example.com
